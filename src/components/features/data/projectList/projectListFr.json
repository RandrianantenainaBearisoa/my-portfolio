        "project_context": {
          "overall_objective": "Application web full-stack d'aide à l'orientation scolaire et professionnelle. Elle permet d'explorer des établissements et des formations, de découvrir ses profils RIASEC et d'identifier des pistes de métiers adaptées à ses intérêts.",
          "project_type": "Projet personnel"
        },
        "initial_problem_challenge": "",
        "approach_and_process": {
          "methodology": [],
          "technos": [
            {
              "name": "LangChain",
              "icon": ""
            },
            {
              "name": "LangGraph",
              "icon": ""
            },
            {
              "name": "Gemini",
              "icon": ""
            },
            {
              "name": "Ollama",
              "icon": ""
            },
            {
              "name": "Fastapi",
              "icon": "fastapi"
            },
            {
              "name": "Tavily",
              "icon": ""
            },
            {
              "name": "Python",
              "icon": ""
            },
            {
              "name": "Vue.js",
              "icon": "vue"
            },
            {
              "name": "PostgreSQL/pgVector",
              "icon": "postgre"
            },
            {
              "name": "Gitlab",
              "icon": "gitlab"
            }
          ],
          "project_lifecycle": [
            {
              "order": 1,
              "stage": "Collecte et extraction des données",
              "description": "Collecter des informations sur les établissements et les métiers à partir de sources PDF et Web configurées. Des agents spécialisés extraient et structurent les informations, et la recherche Web sur les établissements peut être assistée par des LLM.",
              "applied_concepts": [
                "Extraction de PDF",
                "Scraping et recherche Web",
                "Sorties structurées de LLM",
                "Workflows d'agents"
              ],
              "stack_and_tools": [
                "Python",
                "LangChain",
                "LangGraph",
                "Google Gemini",
                "Tavily",
                "pdfplumber"
              ]
            },
            {
              "order": 2,
              "stage": "Préparation et ingestion des données",
              "description": "Orchestrer les étapes d'extraction et de préparation, puis charger en base les données préparées sur les établissements, les métiers et le RIASEC afin qu'elles soient utilisées par l'application.",
              "applied_concepts": [
                "Pipelines ETL",
                "Normalisation des données",
                "Persistance relationnelle",
                "Stockage de données vectorielles"
              ],
              "stack_and_tools": [
                "Python",
                "PostgreSQL",
                "SQLModel",
                "pgvector"
              ]
            },
            {
              "order": 3,
              "stage": "API backend et recherche sémantique",
              "description": "Fournir des endpoints pour la recherche sémantique d'établissements, l'accès à leurs informations, le questionnaire RIASEC, les profils de personnalité et les suggestions de métiers associées. Les embeddings sont générés avec le modèle Ollama configuré.",
              "applied_concepts": [
                "Développement d'API REST",
                "Recherche sémantique",
                "Embeddings",
                "Intégration d'API"
              ],
              "stack_and_tools": [
                "FastAPI",
                "Python",
                "PostgreSQL",
                "pgvector",
                "Ollama",
                "nomic-embed-text-v2-moe"
              ]
            },
            {
              "order": 4,
              "stage": "Parcours d'orientation",
              "description": "Proposer une interface Web où rechercher des établissements avec une description libre, consulter les informations disponibles, répondre au test RIASEC et explorer des métiers suggérés à partir des profils dominants.",
              "applied_concepts": [
                "Architecture d'application full-stack",
                "Gestion d'état frontend",
                "Interface pilotée par API",
                "Parcours utilisateur guidé"
              ],
              "stack_and_tools": [
                "Vue 3",
                "TypeScript",
                "Vite",
                "Vue Router",
                "Pinia",
                "PrimeVue"
              ]
            }
          ]
        },
        "key_concepts": [
          "Recherche sémantique",
          "Extraction de données assistée par LLM",
          "Pipelines de données PDF et Web"
        ],
