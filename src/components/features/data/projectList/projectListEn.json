              "icon": ""
            },
            {
              "name": "Python",
              "icon": ""
            },
            {
              "name": "Vue.js",
              "icon": "vue"
            },
            {
              "name": "PostgreSQL/pgVector",
              "icon": "postgre"
            },
            {
              "name": "Gitlab",
              "icon": "gitlab"
            }
          ],
          "project_lifecycle": [
            {
              "order": 1,
              "stage": "Data Collection and Extraction",
              "description": "Collect information about educational institutions and careers from configured PDF and web sources. Specialized agents extract and structure institution and job information, with LLM-assisted web research for institution details.",
              "applied_concepts": [
                "PDF parsing",
                "Web scraping and research",
                "Structured LLM output",
                "Agent workflows"
              ],
              "stack_and_tools": [
                "Python",
                "LangChain",
                "LangGraph",
                "Google Gemini",
                "Tavily",
                "pdfplumber"
              ]
            },
            {
              "order": 2,
              "stage": "Data Preparation and Ingestion",
              "description": "Orchestrate extraction and preparation pipelines, then load the prepared institution, career, and RIASEC data into the database for use by the application.",
              "applied_concepts": [
                "ETL pipelines",
                "Data normalization",
                "Relational persistence",
                "Vector data storage"
              ],
              "stack_and_tools": [
                "Python",
                "PostgreSQL",
                "SQLModel",
                "pgvector"
              ]
            },
            {
              "order": 3,
              "stage": "Backend API and Semantic Search",
              "description": "Expose endpoints for semantic institution search, institution information retrieval, the RIASEC questionnaire, personality profiles, and related career suggestions. Embeddings are generated through the configured Ollama model.",
              "applied_concepts": [
                "REST API development",
                "Semantic retrieval",
                "Embeddings",
                "API integration"
              ],
              "stack_and_tools": [
                "FastAPI",
                "Python",
                "PostgreSQL",
                "pgvector",
                "Ollama",
                "nomic-embed-text-v2-moe"
              ]
            },
            {
              "order": 4,
              "stage": "Guidance Experience",
              "description": "Provide a web interface where users can search for institutions using a free-text description, review available institution information, complete the RIASEC test, and explore suggested careers based on their dominant profiles.",
              "applied_concepts": [
                "Full-stack application architecture",
                "Frontend state management",
                "API-driven interface",
                "Guided user flows"
              ],
              "stack_and_tools": [
                "Vue 3",
                "TypeScript",
                "Vite",
                "Vue Router",
                "Pinia",
                "PrimeVue"
              ]
            }
          ]
        },
